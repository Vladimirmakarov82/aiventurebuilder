{
  "cleanUrls": true,
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/journal-c0f4ba",
      "destination": "/journal/",
      "permanent": true
    },
    {
      "source": "/journal-c0f4ba/",
      "destination": "/journal/",
      "permanent": true
    },
    {
      "source": "/journal-c0f4ba/(.*)",
      "destination": "/journal/",
      "permanent": true
    },
    {
      "source": "/journal/menu",
      "destination": "/journal/",
      "permanent": true
    },
    {
      "source": "/journal/menu/",
      "destination": "/journal/",
      "permanent": true
    },
    {
      "source": "/journal/menu-a/",
      "destination": "/journal/",
      "permanent": true
    },
    {
      "source": "/journal/menu-b/",
      "destination": "/journal/",
      "permanent": true
    },
    {
      "source": "/journal/menu-c/",
      "destination": "/journal/",
      "permanent": true
    },
    {
      "source": "/journal/menu-a",
      "destination": "/journal/",
      "permanent": true
    },
    {
      "source": "/journal/menu-b",
      "destination": "/journal/",
      "permanent": true
    },
    {
      "source": "/journal/menu-c",
      "destination": "/journal/",
      "permanent": true
    },
    {
      "source": "/journal/discoveries",
      "destination": "/journal/",
      "permanent": false
    },
    {
      "source": "/journal/discoveries/",
      "destination": "/journal/",
      "permanent": false
    },
    {
      "source": "/journal/lifestyle",
      "destination": "/journal/",
      "permanent": false
    },
    {
      "source": "/journal/lifestyle/",
      "destination": "/journal/",
      "permanent": false
    },
    {
      "source": "/journal/family",
      "destination": "/journal/",
      "permanent": false
    },
    {
      "source": "/journal/family/",
      "destination": "/journal/",
      "permanent": false
    },
    {
      "source": "/journal/meaning",
      "destination": "/journal/",
      "permanent": false
    },
    {
      "source": "/journal/meaning/",
      "destination": "/journal/",
      "permanent": false
    },
    {
      "source": "/journal/privacy",
      "destination": "/journal/",
      "permanent": false
    },
    {
      "source": "/journal/privacy/",
      "destination": "/journal/",
      "permanent": false
    },
    {
      "source": "/journal/badge/:p*",
      "destination": "/journal/profile/",
      "permanent": false
    }
  ],
  "ignoreCommand": "exit 1",
  "functions": {
    "api/j.mjs": {
      "includeFiles": "api/_data/**",
      "maxDuration": 60
    },
    "api/crm.mjs": {
      "includeFiles": "api/_data/**"
    }
  },
  "crons": [
    {
      "path": "/api/j/?r=cron",
      "schedule": "10 8 * * *"
    },
    {
      "path": "/api/crm/?r=cron",
      "schedule": "40 5 * * *"
    }
  ],
  "headers": [
    {
      "source": "/i/(.*)",
      "headers": [
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/i",
      "headers": [
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/crm/(.*)",
      "headers": [
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/crm",
      "headers": [
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ]
}